{
  "name": "deti-marii-volunteer-portal",
  "version": "0.2.0",
  "private": true,
  "description": "Monolithic volunteer portal for the Deti Marii charity foundation",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/migrate.js",
    "admin:create": "node src/admin.js",
    "password:reset": "node src/reset-password.js",
    "demo:seed": "node src/seed.js",
    "demo:cards": "node scripts/demo-cards.js",
    "demo": "node scripts/local-demo.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "nodemailer": "10.1.7",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
