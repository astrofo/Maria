# Generate .env with: node scripts/configure.mjs --mode local
# For a server: node scripts/configure.mjs --mode production --domain volunteers.example.org
# The generator creates random secrets and never overwrites an existing file.
DOMAIN=volunteers.example.org
PUBLIC_ORIGIN=https://volunteers.example.org
CADDY_CONFIG=./deploy/Caddyfile
# For an IP-only site, use CADDY_CONFIG=./deploy/Caddyfile.ip.
# Optional exact frontend origins, separated by commas; no wildcard or paths.
FRONTEND_ORIGINS=
POSTGRES_DB=volunteer_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=
SESSION_SECRET=
REGISTRATION_ENABLED=false
# Keep random for real email delivery. Registration always uses unique codes.
EMAIL_CODE_MODE=random
# Exact existing test accounts allowed to log in with 1234. No wildcard domains.
# Leave empty when test login is not needed. Never add a real personal mailbox.
EMAIL_DEMO_ACCOUNTS=
# Publish the foundation's approved documents, then set URLs and enable registration.
PRIVACY_URL=
RULES_URL=
CONSENT_VERSION=1
# Optional local Kistik model. Run scripts/prepare-assistant.sh first, then set
# COMPOSE_PROFILES=assistant and ASSISTANT_URL=http://ollama:11434 on the VPS.
# Empty URL keeps the built-in guide available without loading model weights.
COMPOSE_PROFILES=
ASSISTANT_ENABLED=true
ASSISTANT_URL=
ASSISTANT_MODEL=qwen3:0.6b
ASSISTANT_TIMEOUT_MS=35000
ASSISTANT_QUEUE_LIMIT=2
ASSISTANT_NUM_CTX=2048
ASSISTANT_NUM_PREDICT=224

# Select one email provider; there is no automatic fallback after an uncertain send.
MAIL_TRANSPORT=smtp
# HTTPS delivery bypasses blocked outbound SMTP ports: MAIL_TRANSPORT=unisender_go
UNISENDER_GO_API_KEY=
UNISENDER_GO_FROM_EMAIL=
UNISENDER_GO_FROM_NAME=Дети Марии
UNISENDER_GO_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1

# SMTP is used with MAIL_TRANSPORT=smtp and EMAIL_CODE_MODE=random.
# Port 465 uses SMTP_SECURE=true. Port 587 uses required STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
